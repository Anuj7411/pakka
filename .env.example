# Razorpay - TEST mode only. Never live keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Google AI Studio -> https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Ed25519 signing key for conformance certificates.
# Raw 32-byte seed, base64. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Never commit a real value. The process refuses to start without this rather
# than issuing records that look like certificates and prove nothing.
CONFORMANCE_SIGNING_KEY=
