{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "reporters": ["json", "progress"],
  "jsonReporter": { "fileName": "reports/mutation-fast.json" },
  "coverageAnalysis": "perTest",
  "mutate": ["src/corpus/rng.ts", "src/normalise/canonical.ts"],
  "timeoutMS": 30000,
  "concurrency": 6,
  "thresholds": { "high": 90, "low": 80, "break": null }
}
