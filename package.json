{
  "name": "conformance-gate",
  "version": "0.1.0",
  "private": true,
  "description": "Pre-authorisation conformance gate for agent-initiated purchases",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test",
    "data:fetch": "bash scripts/fetch-data.sh",
    "data:verify": "node scripts/verify-data.mjs",
    "coverage": "vitest run --coverage --coverage.provider=v8 --coverage.include='src/**'",
    "mutation": "stryker run"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/vitest-runner": "^8.7.1",
    "@types/node": "22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "dependencies": {
    "dotenv": "16.4.7"
  }
}
